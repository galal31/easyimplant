RewriteEngine On

# Prevent directory listing
Options -Indexes

# Cache static media in the browser. Versioned URLs in the page ensure that
# replacing the logo or hero video invalidates the old cached response.
<IfModule mod_expires.c>
    ExpiresActive On

    ExpiresByType image/avif "access plus 30 days"
    ExpiresByType image/gif "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/x-icon "access plus 30 days"

    ExpiresByType video/mp4 "access plus 30 days"
    ExpiresByType video/ogg "access plus 30 days"
    ExpiresByType video/webm "access plus 30 days"

    ExpiresByType font/otf "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
    ExpiresByType application/vnd.ms-fontobject "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(?:avif|gif|ico|jpe?g|png|svg|webp)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>

    <FilesMatch "\.(?:mp4|ogv|webm)$">
        Header set Cache-Control "public, max-age=2592000"
        Header set Accept-Ranges "bytes"
    </FilesMatch>

    <FilesMatch "\.(?:eot|otf|ttf|woff2?)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

# Remove .php extension from URLs
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.*)$ $1.php [NC,L]

# Optional: Redirect direct .php requests to extensionless URLs
RewriteCond %{REQUEST_METHOD} GET
RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?] [NC]
RewriteRule ^ /%1 [R=301,NE,L]
